# Unity 工程忽略规则（Unity.gitignore 标准版）

# Unity 自动生成的缓存目录
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# 崩溃日志
sysinfo.txt
*.stackdump
crashlytics-build.properties

# 自动生成的工程文件
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio / Rider 缓存
.vs/
.vscode/
.idea/
.gradle/

# 操作系统生成的文件
.DS_Store
Thumbs.db
desktop.ini

# 打包产物
*.apk
*.aab
*.unitypackage
*.app

# Blender 备份
*.blend1
*.blend1.meta

# 本项目的工具数据（AI 工作区记忆，不属于工程内容）
/.workbuddy-ai/
